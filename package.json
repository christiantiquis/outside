{
  "name": "outside",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 9102 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 9102 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
